---
import { Image } from 'astro:assets';
import event2 from '../assets/images/event-2.jpg';
import event11 from '../assets/images/event-11.jpg';
import event10 from '../assets/images/event-10.jpg';
import event8 from '../assets/images/event-8.jpg';
import event9 from '../assets/images/event-9.jpg';
import event3 from '../assets/images/event-3.jpg';
import event12 from '../assets/images/event-12.jpg';
import event4 from '../assets/images/event-4.jpg';
import event6 from '../assets/images/event-6.jpg';
import event5 from '../assets/images/event-5.jpg';
import event13 from '../assets/images/event-13.jpg';
import event14 from '../assets/images/event-14.jpg';
import event1 from '../assets/images/event-1.jpg';
import event15 from '../assets/images/event-15.jpg';

const images = [
  { src: event2, alt: 'Meetup at Newspeak House' },
  { src: event11, alt: 'Social at Seven Dials Market' },
  { src: event10, alt: 'Denise Melchin on Earning to Give' },
  { src: event8, alt: 'Chris Rouse on the future of EA & giving' },
  { src: event9, alt: 'Member with a GWWC pledge certificate', position: 'object-[center_20%]' },
  { src: event3, alt: 'Summer Picnic' },
  { src: event12, alt: 'Quarterly Co-working session' },
  { src: event4, alt: 'Social at Newspeak House' },
  { src: event6, alt: 'Pub Social' },
  { src: event5, alt: 'Pub Social' },
  { src: event13, alt: 'Talk on founding and funding effective charities' },
  { src: event14, alt: 'Effective animal charities event' },
  { src: event1, alt: 'Summer Picnic' },
  { src: event15, alt: 'Effective giving debate' },
];
---

<section id="gallery" class="py-24 sm:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">

    <h2 class="font-display text-4xl sm:text-5xl text-slate-900 leading-tight text-center mb-12">
      Past Events
    </h2>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 lg:gap-5">
      {[...images].reverse().map((image) => (
        <div class="group relative overflow-hidden rounded-2xl shadow-sm aspect-[4/3]">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 400px, 50vw"
            class={`w-full h-full object-cover ${image.position ?? 'object-center'} transition-transform duration-500 ease-out group-hover:scale-[1.03]`}
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 px-4 py-4
                      bg-gradient-to-t from-black/75 via-black/40 to-transparent
                      translate-y-full group-hover:translate-y-0
                      transition-transform duration-300 ease-out">
            <p class="text-white text-sm font-medium leading-snug tracking-wide">
              {image.alt}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
